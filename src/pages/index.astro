---
import Layout from "../layouts/Layout.astro";
import ChapterIndicator from "../components/islands/ChapterIndicator.vue";
import CoordinateDrift from "../components/islands/CoordinateDrift.vue";
import CinematicOpening from "../components/ui/CinematicOpening.astro";
import LogoMark from "../components/ui/LogoMark.astro";
import TreeOfGrowth from "../components/ui/TreeOfGrowth.astro";
import Chapter00Hero from "../components/sections/Chapter00Hero.astro";
import Chapter01Origin from "../components/sections/Chapter01Origin.astro";
import Chapter02Craft from "../components/sections/Chapter02Craft.astro";
import Chapter03Knowing from "../components/sections/Chapter03Knowing.astro";
import Chapter04Leap from "../components/sections/Chapter04Leap.astro";
import Chapter05Now from "../components/sections/Chapter05Now.astro";
import Chapter06Ethos from "../components/sections/Chapter06Ethos.astro";
import Chapter07Contact from "../components/sections/Chapter07Contact.astro";
import { chapters, site } from "../content/story";

const indicatorChapters = chapters.map((c) => ({
  id: c.id,
  num: c.num,
  label: c.eyebrow,
  tone: c.tone,
}));

// no-JS/first-paint sunrise: evenly spaced stops; useGroundGradient re-measures
// the real section centers on the client and refines these
const fallbackStops = chapters.map(
  (c, i) => c.ground + " " + (((i + 0.5) / chapters.length) * 100).toFixed(1) + "%",
);
const fallbackGradient = "linear-gradient(to bottom, " + fallbackStops.join(", ") + ")";
---

<Layout title={`${site.name} — ${site.role}`}>
  <a
    href="#main"
    class="sr-only z-50 rounded-full bg-accent px-5 py-2 text-dusk-950 focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
  >
    Skip to content
  </a>

  <CinematicOpening />

  <header
    class="site-topbar fixed inset-x-0 top-0 z-40 flex items-center justify-between px-6 py-5 md:px-[7vw]"
  >
    <a
      href="#hero"
      data-site-logo
      aria-label={`${site.wordmark} — home`}
      class="site-logo inline-flex focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current"
    >
      <LogoMark class="h-7 w-auto" />
    </a>
    <div class="flex items-center gap-4">
      <!-- the scene's ambience: silent until asked for (fine pointers only,
           where the wind it follows exists) -->
      <button
        type="button"
        data-sound
        aria-pressed="false"
        aria-label="Sound"
        class="sound-toggle hidden size-8 items-center justify-center rounded-full border border-current/25 transition-[border-color,scale] duration-150 ease-hop pointer-fine:inline-flex hover:border-current/60 active:scale-[0.94] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-current"
      >
        <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.5 6.2h2.2L8 3.5v9L4.7 9.8H2.5z"></path>
          <path class="wave" d="M10.5 6c.7.6.7 3.4 0 4"></path>
          <path class="wave" d="M12.3 4.4c1.6 1.4 1.6 5.8 0 7.2"></path>
        </svg>
      </button>
      <a
        href={`mailto:${site.email}`}
        class="rounded-full bg-accent px-5 py-2 font-sans text-[10px] tracking-[0.25em] text-dusk-950 uppercase transition-[background-color,scale] duration-150 ease-hop hover:bg-accent-strong active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-accent-strong"
      >
        Email me
      </a>
    </div>
  </header>

  <div id="ground" class="relative" style={`background-image: ${fallbackGradient}`}>
    <TreeOfGrowth />

    <main id="main">
      <Chapter00Hero />
      <Chapter01Origin />
      <Chapter02Craft />
      <Chapter03Knowing />
      <Chapter04Leap />
      <Chapter05Now />
      <Chapter06Ethos />
    </main>

    <Chapter07Contact />
  </div>

  <ChapterIndicator client:visible chapters={indicatorChapters} />
  <CoordinateDrift client:visible />

  <!-- the whole frame sits on cold-press paper, chrome included -->
  <div class="paper-tooth pointer-events-none fixed inset-0 z-50" aria-hidden="true"></div>
</Layout>

<style>
  .site-topbar {
    color: var(--color-ink);
    transition: color 0.5s ease;
  }
  :root[data-ground="sand"] .site-topbar {
    color: var(--color-sand-ink);
  }
  .sound-toggle .wave {
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .sound-toggle[aria-pressed="true"] .wave {
    opacity: 1;
  }
  /* while the bumper owns the frame, its flying mark IS the logo */
  :global(:root.cine-play) .site-logo {
    opacity: 0;
  }
</style>

<script>
  import {
    prefersReducedMotion,
    registerGsap,
    useDayScrub,
    useGroundGradient,
    useGroundTone,
    useSceneLife,
  } from "../lib/gsap";
  import { createAmbience } from "../lib/ambience";
  import { chapters } from "../content/story";

  // one document-long sunrise: a measured stop at each chapter's center, so
  // every tone change between sections is a smooth gradation
  useGroundGradient(
    "#ground",
    chapters.map((c) => ({ id: c.id, color: c.ground })),
  );

  // flip chrome + tree ink to the light ground at THE WIDER WORLD — works on
  // mobile too, where the ChapterIndicator island is display:none
  useGroundTone("#now");
  // the bottom-edge HUD turns as soon as the light ground reaches it
  useGroundTone("#now", { attr: "hud", start: "top bottom" });

  // the day arrives under the reader's hand: scene pigments, tree ink and
  // paper tooth blend with the scroll across The Leap → Now
  useDayScrub(Array.from(document.querySelectorAll(".tree-art, .paper-tooth")), "#now");

  // the world answers the hand, and the ambience hears the same wind
  const ambience = createAmbience();
  useSceneLife("#tree-of-growth", { onFrame: ambience.frame, onTouch: ambience.tock });
  const sound = document.querySelector<HTMLButtonElement>("[data-sound]");
  sound?.addEventListener("click", () => {
    ambience.enable(!ambience.enabled);
    sound.setAttribute("aria-pressed", String(ambience.enabled));
  });

  // the logo rewinds time: the whole tree un-grows back to the seed, and any
  // wheel or touch hands control straight back
  document.querySelector("[data-site-logo]")?.addEventListener("click", (e) => {
    if (prefersReducedMotion() || window.scrollY < 8) return;
    e.preventDefault();
    const gsap = registerGsap();
    gsap.to(window, {
      duration: gsap.utils.clamp(0.8, 2.4, 0.8 + window.scrollY / 4000),
      ease: "power2.inOut",
      scrollTo: { y: 0, autoKill: true },
    });
  });
</script>
